# Conexión a MongoDB (obligatoria)
MONGOOSE_CONNECT=mongodb+srv://usuario:contrasena@cluster.mongodb.net/novatadas

# Clave de firma de las sesiones (obligatoria, mínimo 32 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_JWT_KEY=

# Ponlo a "production" en el despliegue: activa la cookie Secure.
NODE_ENV=development

PORT=3000
SERVER_URL=http://localhost
SALT_ROUNDS=10

# Curso que se muestra en la interfaz
EDITION=26-27

# Avisos de Discord (opcionales)
DISCORD_WEBHOOK_LOGIN=
DISCORD_WEBHOOK_REQUEST_CHALLENGE=

# Solo para el script de envío de credenciales
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=
WEB_URL=https://novatadasinformatica.onrender.com
