<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Iniciar sesión · Novatadas Informática', extraStyles: ['/styles/password.css', '/styles/login.css'] }) %>
</head>

<body class="login-body">
  <%- include('partials/toast') %>

  <main class="login-card">
    <div class="login-brand">
      <span class="login-brand__mark" aria-hidden="true">N</span>
      <div>
        <p class="login-brand__name">Novatadas Informática</p>
        <p class="login-brand__edition">Curso <%= edition %></p>
      </div>
    </div>

    <h1 class="login-title">Iniciar sesión</h1>
    <p class="login-subtitle">Entra con las credenciales que recibiste por correo.</p>

    <form id="login-form" novalidate>
      <div class="field">
        <label for="email">Correo</label>
        <input class="input" type="email" id="email" name="email" autocomplete="username"
          inputmode="email" placeholder="nombre@ejemplo.com" required>
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <div class="password-container">
          <input class="input" type="password" id="password" name="password"
            autocomplete="current-password" placeholder="Tu contraseña" required>
          <button class="hide-password" type="button" aria-label="Mostrar contraseña">
            <i class="fa-regular fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn--primary btn--block" id="login-submit">
        <span class="login-submit__label">Entrar</span>
      </button>
    </form>

    <p class="login-foot">¿Problemas para entrar? Avisa a cualquier veterano.</p>
  </main>

  <script>
    const $ = (selector) => document.querySelector(selector)

    const loginForm = $('#login-form')
    const submitButton = $('#login-submit')
    const submitLabel = $('.login-submit__label')
    const passwordInput = $('#password')
    const hidePassBtn = $('.hide-password')

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault()

      const email = $('#email').value.trim().toLowerCase()
      const password = passwordInput.value

      if (!email || !password) return notify('Rellena el correo y la contraseña.')

      submitButton.disabled = true
      submitLabel.textContent = 'Entrando…'

      try {
        const res = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        })

        const data = await res.json()

        if (!res.ok || data.err) {
          notify(data.err || 'No se ha podido iniciar sesión.')
          submitButton.disabled = false
          submitLabel.textContent = 'Entrar'
          return
        }

        window.location.href = '/scoreboard'
      } catch (error) {
        notify('No hay conexión con el servidor.')
        submitButton.disabled = false
        submitLabel.textContent = 'Entrar'
      }
    })

    hidePassBtn.addEventListener('click', () => {
      const isHidden = passwordInput.type === 'password'

      passwordInput.type = isHidden ? 'text' : 'password'
      hidePassBtn.setAttribute('aria-label', isHidden ? 'Ocultar contraseña' : 'Mostrar contraseña')
      hidePassBtn.querySelector('i').className = isHidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye'
    })
  </script>
</body>

</html>
