<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Retos · Novatadas Informática', extraStyles: ['/styles/navigation.css', '/styles/challenges.css'] }) %>
</head>

<body>
  <%- include('partials/toast') %>
  <%- include('partials/appbar', { active: 'challenges' }) %>

  <%
    const isStaff = loggedUser.isAdmin || loggedUser.isSuperAdmin
    const completedSet = new Set(completedChallenges || [])
    const pendingSet = new Set(pendingChallenges || [])

    const stateOf = (challenge) => {
      if (isStaff) return 'staff'
      if (completedSet.has(challenge._id)) return 'done'
      if (pendingSet.has(challenge._id)) return 'pending'
      return 'open'
    }

    const doneCount = allChallenges.filter((c) => completedSet.has(c._id)).length
    const pendingCount = allChallenges.filter((c) => pendingSet.has(c._id)).length
    const openCount = allChallenges.length - doneCount - pendingCount
    const percent = allChallenges.length > 0 ? Math.round(doneCount / allChallenges.length * 100) : 0
  %>

  <main class="page">
    <div class="page-head">
      <div>
        <p class="eyebrow">Curso <%= edition %></p>
        <h1 class="display display--lg">Retos</h1>
      </div>

      <% if (!isStaff) { %>
      <div class="progress">
        <div class="progress__top">
          <span class="progress__label">Tu progreso</span>
          <span class="progress__value num"><%= doneCount %>/<%= allChallenges.length %></span>
        </div>
        <div class="progress__track" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
          <div class="progress__bar" style="width: <%= percent %>%"></div>
        </div>
      </div>
      <% } %>
    </div>

    <% if (allChallenges.length === 0) { %>
    <div class="panel empty-state">Todavía no hay retos publicados.</div>
    <% } else { %>

    <% if (!isStaff) { %>
    <div class="filters" role="group" aria-label="Filtrar retos">
      <button class="filter" data-filter="all" aria-pressed="true">Todos <span class="filter__count"><%= allChallenges.length %></span></button>
      <button class="filter" data-filter="open" aria-pressed="false">Disponibles <span class="filter__count"><%= openCount %></span></button>
      <button class="filter" data-filter="pending" aria-pressed="false">Pendientes <span class="filter__count"><%= pendingCount %></span></button>
      <button class="filter" data-filter="done" aria-pressed="false">Completados <span class="filter__count"><%= doneCount %></span></button>
    </div>
    <% } %>

    <section class="grid grid--cards" id="challenge-grid">
      <% allChallenges.forEach((challenge) => { %>
      <% const state = stateOf(challenge) %>
      <article
        class="challenge<%= state === 'staff' ? '' : ' challenge--' + state %>"
        id="challenge-card-<%= challenge._id %>"
        data-state="<%= state %>"
        data-points="<%= challenge.points %>"
        <%= state === 'open' ? 'tabindex=0 role=button' : '' %>>

        <div class="challenge__top">
          <h2 class="challenge__title"><%= challenge.title %></h2>
          <span class="points-chip num"><%= challenge.points %> pts</span>
        </div>

        <p class="challenge__desc"><%= challenge.description %></p>

        <div class="challenge__foot">
          <% if (state === 'open') { %>
          <span class="challenge__hint">Pulsa para solicitarlo</span>
          <% } else if (state === 'pending') { %>
          <span class="badge badge--accent">Pendiente de validar</span>
          <% } else if (state === 'done') { %>
          <span class="badge badge--mint">Completado</span>
          <% } else { %>
          <span class="badge">Vista de administrador</span>
          <% } %>

          <% if (isStaff) { %>
          <div class="challenge__actions">
            <button class="btn btn--sm edit-challenge-trigger" type="button">Editar</button>
            <% if (loggedUser.isSuperAdmin) { %>
            <button class="btn btn--danger btn--sm delete-challenge-trigger" data-challenge-id="<%= challenge._id %>"
              data-challenge-title="<%= challenge.title %>" type="button">Eliminar</button>
            <% } %>
          </div>
          <% } %>
        </div>
      </article>
      <% }) %>
    </section>
    <% } %>

    <% if (isStaff) { %>
    <p class="admin-note">Estás viendo la lista como administrador.</p>
    <% } %>
  </main>

  <% if (isStaff) { %>
  <dialog class="modal" id="edit-dialog">
    <form class="modal__body" id="edit-form" novalidate>
      <h3 class="modal__title mb-1">Editar reto</h3>

      <div class="field">
        <label for="edit-title">Título</label>
        <input class="input" type="text" id="edit-title" maxlength="120" autocomplete="off" required>
      </div>

      <div class="field">
        <label for="edit-description">Descripción</label>
        <textarea class="textarea" id="edit-description" maxlength="600" required></textarea>
      </div>

      <div class="field">
        <label for="edit-points">Puntos</label>
        <input class="input" type="number" id="edit-points" min="0" required>
        <p class="field-hint">
          Si cambias los puntos, se ajusta también la puntuación de quien ya tenga el reto validado.
        </p>
      </div>

      <div class="modal__actions">
        <button class="btn btn--ghost" type="button" data-close>Cancelar</button>
        <button class="btn btn--primary" type="submit" id="edit-submit">Guardar cambios</button>
      </div>
    </form>
  </dialog>
  <% } %>

  <!-- Diálogo único reutilizado por todas las tarjetas. -->
  <dialog class="modal" id="confirm-dialog">
    <div class="modal__body">
      <h3 class="modal__title" id="confirm-title">Confirmar</h3>
      <p class="modal__text" id="confirm-text"></p>
      <div class="modal__actions">
        <button class="btn btn--ghost" type="button" data-close>Cancelar</button>
        <button class="btn btn--primary" type="button" id="confirm-accept">Confirmar</button>
      </div>
    </div>
  </dialog>

  <script>
    const $ = (selector) => document.querySelector(selector)
    const $$ = (selector) => document.querySelectorAll(selector)

    const dialog = $('#confirm-dialog')
    const dialogTitle = $('#confirm-title')
    const dialogText = $('#confirm-text')
    const acceptButton = $('#confirm-accept')

    let onAccept = null

    /** Abre el diálogo con un texto y una acción concretos. */
    function confirmAction ({ title, text, acceptLabel, variant = 'primary', action }) {
      dialogTitle.textContent = title
      dialogText.textContent = text
      acceptButton.textContent = acceptLabel
      acceptButton.className = `btn btn--${variant}`
      onAccept = action
      dialog.showModal()
    }

    acceptButton.addEventListener('click', async () => {
      const action = onAccept
      dialog.close()
      if (action) await action()
    })

    $$('#confirm-dialog [data-close]').forEach((button) => {
      button.addEventListener('click', () => dialog.close())
    })

    // Clic fuera del cuadro para cerrar.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
  </script>

  <% if (!isStaff) { %>
  <script>
    const filterButtons = $$('.filter')
    const cards = $$('#challenge-grid .challenge')

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        filterButtons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)))

        const filter = button.dataset.filter
        cards.forEach((card) => {
          card.classList.toggle('hidden', filter !== 'all' && card.dataset.state !== filter)
        })
      })
    })

    async function requestChallenge (card) {
      const challengeId = card.id.replace('challenge-card-', '')

      try {
        const res = await fetch('/challenges/request-complete-challenge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ challengeId })
        })

        const data = await res.json()

        if (!res.ok || data.err) return notify(data.err || 'No se ha podido solicitar el reto.')

        card.classList.remove('challenge--open')
        card.classList.add('challenge--pending')
        card.dataset.state = 'pending'
        card.removeAttribute('tabindex')
        card.removeAttribute('role')
        card.querySelector('.challenge__hint').outerHTML =
          '<span class="badge badge--accent">Pendiente de validar</span>'

        notify(`${data.pendingChallengeAdded.title} · solicitado correctamente.`, 2200, 'success')
      } catch (error) {
        notify('No hay conexión con el servidor.')
      }
    }

    cards.forEach((card) => {
      const open = () => {
        if (card.dataset.state !== 'open') return

        confirmAction({
          title: 'Solicitar reto',
          text: `¿Seguro que quieres solicitar "${card.querySelector('.challenge__title').textContent}"? Un veterano tendrá que validarlo.`,
          acceptLabel: 'Solicitar',
          action: () => requestChallenge(card)
        })
      }

      card.addEventListener('click', open)
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()
          open()
        }
      })
    })
  </script>
  <% } %>

  <% if (isStaff) { %>
  <script>
    const editDialog = $('#edit-dialog')
    const editForm = $('#edit-form')
    const editSubmit = $('#edit-submit')

    let editingCard = null

    $$('.edit-challenge-trigger').forEach((button) => {
      button.addEventListener('click', (event) => {
        // La tarjeta de un novato es pulsable entera; en la de administrador no,
        // pero paramos el evento igual por si algún día vuelve a serlo.
        event.stopPropagation()

        editingCard = button.closest('.challenge')

        $('#edit-title').value = editingCard.querySelector('.challenge__title').textContent.trim()
        $('#edit-description').value = editingCard.querySelector('.challenge__desc').textContent.trim()
        $('#edit-points').value = editingCard.dataset.points

        editDialog.showModal()
      })
    })

    editForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!editingCard) return

      const challengeId = editingCard.id.replace('challenge-card-', '')
      const title = $('#edit-title').value.trim()
      const description = $('#edit-description').value.trim()
      const points = $('#edit-points').value

      if (!title || !description || points === '') return notify('Rellena todos los campos.')

      editSubmit.disabled = true
      editSubmit.textContent = 'Guardando…'

      try {
        const res = await fetch('/challenges/edit-challenge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ challengeId, title, description, points: Number(points) })
        })

        const data = await res.json()

        if (!res.ok || data.err) return notify(data.err || 'No se ha podido guardar el reto.')

        // Actualizamos la tarjeta en el sitio, sin recargar.
        editingCard.querySelector('.challenge__title').textContent = data.title
        editingCard.querySelector('.challenge__desc').textContent = data.description
        editingCard.querySelector('.points-chip').textContent = `${data.points} pts`
        editingCard.dataset.points = data.points

        const deleteButton = editingCard.querySelector('.delete-challenge-trigger')
        if (deleteButton) deleteButton.dataset.challengeTitle = data.title

        editDialog.close()

        notify(
          data.pointsDelta === 0
            ? 'Reto actualizado.'
            : `Reto actualizado · ${data.affectedUsers} usuario(s) reajustados.`,
          2600,
          'success'
        )
      } catch (error) {
        notify('No hay conexión con el servidor.')
      } finally {
        editSubmit.disabled = false
        editSubmit.textContent = 'Guardar cambios'
      }
    })

    $$('#edit-dialog [data-close]').forEach((button) => {
      button.addEventListener('click', () => editDialog.close())
    })

    editDialog.addEventListener('click', (event) => {
      if (event.target === editDialog) editDialog.close()
    })
  </script>
  <% } %>

  <% if (loggedUser.isSuperAdmin) { %>
  <script>
    $$('.delete-challenge-trigger').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.stopPropagation()

        const { challengeId, challengeTitle } = button.dataset

        confirmAction({
          title: 'Eliminar reto',
          text: `Se borrará "${challengeTitle}" y dejará de contar para todos los usuarios. Esta acción no se puede deshacer.`,
          acceptLabel: 'Eliminar',
          variant: 'danger',
          action: async () => {
            try {
              const res = await fetch('/challenges/delete-challenge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ challengeId })
              })

              const data = await res.json()

              if (!res.ok || data.err) return notify(data.err || 'No se ha podido eliminar el reto.')

              document.getElementById(`challenge-card-${challengeId}`)?.remove()
              notify('Reto eliminado correctamente.', 2200, 'success')
            } catch (error) {
              notify('No hay conexión con el servidor.')
            }
          }
        })
      })
    })
  </script>
  <% } %>
</body>

</html>
