<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: userToShow.name + ' · Novatadas Informática', extraStyles: ['/styles/navigation.css', '/styles/profile.css'] }) %>
</head>

<body>
  <%- include('partials/toast') %>
  <%- include('partials/appbar', { active: 'scoreboard' }) %>

  <%
    const extraPoints = userToShow.extraPoints || []
    const totalActivities = completedChalleges.length + extraPoints.length + pendingChallenges.length
    const isSelf = userToShow._id === loggedUser.id
  %>

  <main class="page">
    <a class="btn btn--ghost btn--sm mb-1" href="/scoreboard">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver al marcador
    </a>

    <section class="profile-head">
      <div class="profile-avatar" aria-hidden="true"><%= userToShow.name.trim().charAt(0).toUpperCase() %></div>
      <div>
        <p class="eyebrow">Perfil</p>
        <h1 class="profile-name"><%= userToShow.name %></h1>
        <div class="profile-tags">
          <span class="badge badge--brand"><%= userToShow.points %> puntos</span>
          <span class="badge"><%= completedChalleges.length + extraPoints.length %> completados</span>
          <% if (pendingChallenges.length > 0) { %>
          <span class="badge badge--accent"><%= pendingChallenges.length %> pendientes</span>
          <% } %>
          <% if (userToShow.isSuperAdmin) { %>
          <span class="badge badge--accent">Super admin</span>
          <% } else if (userToShow.isAdmin) { %>
          <span class="badge badge--mint">Veterano</span>
          <% } %>
          <% if (isSelf) { %><span class="badge badge--brand">Tú</span><% } %>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Actividad</h2>
        <span class="badge"><%= totalActivities %></span>
      </div>

      <% if (totalActivities === 0) { %>
      <div class="empty-state">
        Todavía no hay actividad registrada.
      </div>
      <% } else { %>

      <% pendingChallenges.forEach((challenge) => { %>
      <div class="entry entry--pending" data-challenge-id="<%= challenge._id %>">
        <span class="entry__icon"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></span>
        <div>
          <p class="entry__title"><%= challenge.title %></p>
          <p class="entry__sub">Pendiente de validar</p>
        </div>
        <div class="entry__right">
          <span class="entry__points num">+<%= challenge.points %></span>
          <% if (loggedUser.isAdmin) { %>
          <div class="entry__actions">
            <button class="icon-btn icon-btn--accept" type="button" data-action="accept"
              title="Validar reto" aria-label="Validar reto">
              <i class="fa-solid fa-check" aria-hidden="true"></i>
            </button>
            <button class="icon-btn icon-btn--reject" type="button" data-action="reject"
              title="Rechazar reto" aria-label="Rechazar reto">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>
          <% } %>
        </div>
      </div>
      <% }) %>

      <% completedChalleges.forEach((challenge) => { %>
      <div class="entry entry--done">
        <span class="entry__icon"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
        <div>
          <p class="entry__title"><%= challenge.title %></p>
          <p class="entry__sub">Reto completado</p>
        </div>
        <div class="entry__right">
          <span class="entry__points num">+<%= challenge.points %></span>
        </div>
      </div>
      <% }) %>

      <% extraPoints.forEach((extra) => { %>
      <div class="entry entry--extra">
        <span class="entry__icon"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></span>
        <div>
          <p class="entry__title"><%= extra.name %></p>
          <p class="entry__sub">Puntos extra</p>
        </div>
        <div class="entry__right">
          <span class="entry__points num">+<%= extra.points %></span>
        </div>
      </div>
      <% }) %>
      <% } %>
    </section>

    <% if (loggedUser.isSuperAdmin && !userToShow.isSuperAdmin && !isSelf) { %>
    <section class="panel danger-zone">
      <div class="panel-head">
        <h2>Acciones de super admin</h2>
      </div>
      <div class="row">
        <% if (userToShow.isAdmin) { %>
        <button class="btn" type="button" id="revoke-admin">
          Quitar administrador
        </button>
        <% } else { %>
        <button class="btn" type="button" id="become-admin">
          Hacer administrador
        </button>
        <% } %>
        <button class="btn" type="button" id="reset-password">
          Nueva contraseña
        </button>
        <button class="btn btn--danger" type="button" id="delete-user">
          Eliminar usuario
        </button>
      </div>
    </section>
    <% } %>
  </main>

  <dialog class="modal" id="confirm-dialog">
    <div class="modal__body">
      <h3 class="modal__title" id="confirm-title">Confirmar</h3>
      <p class="modal__text" id="confirm-text"></p>
      <div class="modal__actions">
        <button class="btn btn--ghost" type="button" data-close>Cancelar</button>
        <button class="btn btn--primary" type="button" id="confirm-accept">Confirmar</button>
      </div>
    </div>
  </dialog>

  <script>
    const $ = (selector) => document.querySelector(selector)
    const $$ = (selector) => document.querySelectorAll(selector)

    const USER_ID = <%- jsonForScript(userToShow._id) %>

    const dialog = $('#confirm-dialog')
    const acceptButton = $('#confirm-accept')
    let onAccept = null

    function confirmAction ({ title, text, acceptLabel, variant = 'primary', action }) {
      $('#confirm-title').textContent = title
      $('#confirm-text').textContent = text
      acceptButton.textContent = acceptLabel
      acceptButton.className = `btn btn--${variant}`
      onAccept = action
      dialog.showModal()
    }

    acceptButton.addEventListener('click', async () => {
      const action = onAccept
      dialog.close()
      if (action) await action()
    })

    $$('#confirm-dialog [data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()))
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close() })

    async function post (url, body) {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      return { ok: res.ok, data: await res.json() }
    }
  </script>

  <% if (loggedUser.isAdmin) { %>
  <script>
    // Validar / rechazar retos pendientes.
    $$('.entry--pending [data-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const entry = button.closest('.entry')
        const challengeId = entry.dataset.challengeId
        const accept = button.dataset.action === 'accept'
        const url = accept
          ? '/challenges/accept-challenge-completed'
          : '/challenges/reject-challenge-completed'

        entry.querySelectorAll('button').forEach((b) => { b.disabled = true })

        try {
          const { ok, data } = await post(url, { userId: USER_ID, challengeId })

          if (!ok || data.err) {
            entry.querySelectorAll('button').forEach((b) => { b.disabled = false })
            return notify(data.err || 'No se ha podido completar la acción.')
          }

          if (accept) {
            entry.classList.replace('entry--pending', 'entry--done')
            entry.querySelector('.entry__icon').innerHTML = '<i class="fa-solid fa-check"></i>'
            entry.querySelector('.entry__sub').textContent = 'Reto completado'
            entry.querySelector('.entry__actions').remove()
            notify('Reto validado correctamente.', 2200, 'success')
          } else {
            entry.remove()
            notify('Reto rechazado.', 2200, 'success')
          }
        } catch (error) {
          entry.querySelectorAll('button').forEach((b) => { b.disabled = false })
          notify('No hay conexión con el servidor.')
        }
      })
    })
  </script>
  <% } %>

  <% if (loggedUser.isSuperAdmin && !userToShow.isSuperAdmin && !isSelf) { %>
  <script>
    const userName = <%- jsonForScript(userToShow.name) %>

    $('#become-admin')?.addEventListener('click', () => confirmAction({
      title: 'Hacer administrador',
      text: `${userName} podrá validar retos y dejará de aparecer en el marcador.`,
      acceptLabel: 'Hacer administrador',
      action: async () => {
        const { ok, data } = await post('/users/become-administrator', { userId: USER_ID })
        if (!ok || data.err) return notify(data.err || 'No se ha podido ascender al usuario.')
        notify('Usuario convertido en administrador.', 2200, 'success')
        setTimeout(() => window.location.reload(), 900)
      }
    }))

    $('#revoke-admin')?.addEventListener('click', () => confirmAction({
      title: 'Quitar administrador',
      text: `${userName} volverá a ser un usuario normal y reaparecerá en el marcador.`,
      acceptLabel: 'Quitar permisos',
      variant: 'danger',
      action: async () => {
        const { ok, data } = await post('/users/revoke-administrator', { userId: USER_ID })
        if (!ok || data.err) return notify(data.err || 'No se ha podido degradar al usuario.')
        notify('Permisos retirados.', 2200, 'success')
        setTimeout(() => window.location.reload(), 900)
      }
    }))

    $('#reset-password')?.addEventListener('click', () => confirmAction({
      title: 'Generar nueva contraseña',
      text: `Se invalidará la contraseña actual de ${userName} y se generará una nueva que tendrás que pasarle tú.`,
      acceptLabel: 'Generar',
      action: async () => {
        const { ok, data } = await post('/users/reset-password', { userId: USER_ID })
        if (!ok || data.err) return notify(data.err || 'No se ha podido cambiar la contraseña.')

        try {
          await navigator.clipboard.writeText(data.password)
          notify(`Nueva contraseña: ${data.password} (copiada al portapapeles)`, 9000, 'success')
        } catch (error) {
          notify(`Nueva contraseña: ${data.password}`, 12000, 'success')
        }
      }
    }))

    $('#delete-user')?.addEventListener('click', () => confirmAction({
      title: 'Eliminar usuario',
      text: `Se borrará la cuenta de ${userName} junto con todos sus puntos y retos. No se puede deshacer.`,
      acceptLabel: 'Eliminar',
      variant: 'danger',
      action: async () => {
        const { ok, data } = await post('/users/delete-user', { userId: USER_ID })
        if (!ok || data.err) return notify(data.err || 'No se ha podido eliminar al usuario.')
        window.location.href = '/scoreboard'
      }
    }))
  </script>
  <% } %>
</body>

</html>
