<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Administración · Novatadas Informática', extraStyles: ['/styles/navigation.css', '/styles/picker.css', '/styles/admin.css', '/styles/password.css'] }) %>
</head>

<body>
  <%- include('partials/toast') %>
  <%- include('partials/appbar', { active: 'admin' }) %>

  <%
    const challengeById = new Map(allChallenges.map((challenge) => [challenge._id, challenge]))

    // Cola de validación: todo lo que está esperando a un veterano, en un sitio.
    const queue = []
    allUsers.forEach((user) => {
      user.pendingChallenges.forEach((challengeId) => {
        const challenge = challengeById.get(String(challengeId))
        if (challenge) queue.push({ user, challenge })
      })
    })
    queue.sort((a, b) => b.challenge.points - a.challenge.points)
  %>

  <main class="page">
    <div class="page-head">
      <div>
        <p class="eyebrow">Panel de veteranos</p>
        <h1 class="display display--lg">Administración</h1>
      </div>
      <div class="row">
        <span class="badge"><%= allUsers.length %> novatos</span>
        <span class="badge"><%= allChallenges.length %> retos</span>
        <% if (queue.length > 0) { %>
        <span class="badge badge--accent"><%= queue.length %> por validar</span>
        <% } %>
      </div>
    </div>

    <!-- ============================ Cola de validación ==================== -->
    <section class="panel mb-1" id="queue-panel">
      <div class="panel-head">
        <h2>Pendientes de validar</h2>
        <span class="badge badge--accent" id="queue-count"><%= queue.length %></span>
      </div>

      <% if (queue.length === 0) { %>
      <div class="empty-state" id="queue-empty">No hay nada pendiente.</div>
      <% } else { %>
      <div class="queue" id="queue-list">
        <% queue.forEach(({ user, challenge }) => { %>
        <div class="queue__item" data-user-id="<%= user.id %>" data-challenge-id="<%= challenge._id %>">
          <div class="queue__who">
            <a class="queue__name" href="/user/<%= user.id %>"><%= user.name %></a>
            <span class="queue__challenge"><%= challenge.title %></span>
          </div>
          <div class="queue__right">
            <span class="points-chip num"><%= challenge.points %></span>
            <button class="icon-btn icon-btn--accept" type="button" data-action="accept"
              title="Validar" aria-label="Validar reto de <%= user.name %>">
              <i class="fa-solid fa-check" aria-hidden="true"></i>
            </button>
            <button class="icon-btn icon-btn--reject" type="button" data-action="reject"
              title="Rechazar" aria-label="Rechazar reto de <%= user.name %>">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </section>

    <div class="grid admin-grid">
      <!-- ============================ Crear usuario ====================== -->
      <section class="panel">
        <div class="panel-head">
          <h2>Crear usuario</h2>
        </div>
        <% if (loggedUser.isSuperAdmin) { %>
        <p class="panel-note">
          ¿Vas a dar de alta a todo un curso? Usa la
          <a class="text-brand" href="/gestion">importación masiva</a>.
        </p>
        <% } %>

        <form id="create-user-form" novalidate>
          <div class="field">
            <label for="user-email">Correo</label>
            <input class="input" type="email" id="user-email" autocomplete="off" placeholder="nombre@ejemplo.com">
          </div>
          <div class="field">
            <label for="user-name">Nombre</label>
            <input class="input" type="text" id="user-name" autocomplete="off" placeholder="Nombre y apellidos">
          </div>
          <div class="field">
            <label for="user-password">Contraseña</label>
            <div class="password-container">
              <input class="input" type="password" id="user-password" autocomplete="new-password" placeholder="Mínimo 8 caracteres">
              <button class="hide-password" type="button" aria-label="Mostrar contraseña">
                <i class="fa-regular fa-eye" aria-hidden="true"></i>
              </button>
            </div>
            <button class="btn btn--ghost btn--sm mt-1" type="button" id="generate-password">
              Generar aleatoria
            </button>
          </div>
          <button class="btn btn--primary btn--block" type="submit">Crear usuario</button>
        </form>
      </section>

      <!-- ============================ Crear reto ========================= -->
      <section class="panel">
        <div class="panel-head">
          <h2>Crear reto</h2>
        </div>

        <form id="create-challenge-form" novalidate>
          <div class="field">
            <label for="challenge-name">Título</label>
            <input class="input" type="text" id="challenge-name" placeholder="El título que verán los novatos">
          </div>
          <div class="field">
            <label for="challenge-description">Descripción</label>
            <textarea class="textarea" id="challenge-description" placeholder="En qué consiste el reto"></textarea>
          </div>
          <div class="field">
            <label for="challenge-points">Puntos</label>
            <input class="input" type="number" min="1" id="challenge-points" placeholder="Cuánto vale el reto">
          </div>
          <button class="btn btn--primary btn--block" type="submit">Crear reto</button>
        </form>
      </section>

      <!-- ============================ Añadir puntos ====================== -->
      <section class="panel">
        <div class="panel-head">
          <h2>Validar reto a mano</h2>
        </div>
        <p class="panel-note">Suma directamente los puntos de un reto sin esperar a la solicitud.</p>

        <form id="add-points-form" novalidate>
          <div class="field">
            <span class="field-label">Usuario</span>
            <div class="picker" id="points-user-picker">
              <input class="input picker__input" type="text" role="combobox" aria-expanded="false"
                autocomplete="off" placeholder="Busca por nombre o correo">
              <input type="hidden" class="picker__value">
              <ul class="picker__list" role="listbox" hidden></ul>
            </div>
          </div>
          <div class="field">
            <span class="field-label">Reto</span>
            <div class="picker" id="points-challenge-picker">
              <input class="input picker__input" type="text" role="combobox" aria-expanded="false"
                autocomplete="off" placeholder="Busca un reto">
              <input type="hidden" class="picker__value">
              <ul class="picker__list" role="listbox" hidden></ul>
            </div>
          </div>
          <button class="btn btn--primary btn--block" type="submit">Añadir puntos</button>
        </form>
      </section>

      <!-- ============================ Puntos extra ======================= -->
      <% if (loggedUser.isSuperAdmin) { %>
      <section class="panel">
        <div class="panel-head">
          <h2>Puntos extra</h2>
        </div>
        <p class="panel-note">Para premios fuera de la lista de retos. Admite valores negativos.</p>

        <form id="add-extra-points-form" novalidate>
          <div class="field">
            <span class="field-label">Usuario</span>
            <div class="picker" id="extra-user-picker">
              <input class="input picker__input" type="text" role="combobox" aria-expanded="false"
                autocomplete="off" placeholder="Busca por nombre o correo">
              <input type="hidden" class="picker__value">
              <ul class="picker__list" role="listbox" hidden></ul>
            </div>
          </div>
          <div class="field">
            <label for="extra-points-text">Concepto</label>
            <input class="input" type="text" id="extra-points-text" placeholder="Por qué se le dan los puntos">
          </div>
          <div class="field">
            <label for="extra-points">Puntos</label>
            <input class="input" type="number" id="extra-points" placeholder="Puede ser negativo">
          </div>
          <button class="btn btn--primary btn--block" type="submit">Añadir puntos extra</button>
        </form>
      </section>
      <% } %>
    </div>
  </main>

  <script src="/js/picker.js"></script>
  <script>
    const $ = (selector) => document.querySelector(selector)
    const $$ = (selector) => document.querySelectorAll(selector)

    const USERS = <%- jsonForScript(allUsers.map((u) => ({ value: u.id, label: u.name, hint: u.email }))) %>
    const CHALLENGES = <%- jsonForScript(allChallenges.map((c) => ({ value: c._id, label: c.title, hint: `${c.points} puntos` }))) %>

    async function post (url, body) {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      return { ok: res.ok, data: await res.json() }
    }

    /* ------------------------------------------------ Cola de validación */

    function refreshQueueCount () {
      const remaining = $$('#queue-list .queue__item').length
      $('#queue-count').textContent = remaining

      if (remaining === 0 && $('#queue-list')) {
        $('#queue-list').outerHTML =
          '<div class="empty-state">No hay nada pendiente.</div>'
      }
    }

    $$('#queue-list [data-action]').forEach((button) => {
      button.addEventListener('click', async () => {
        const item = button.closest('.queue__item')
        const { userId, challengeId } = item.dataset
        const accept = button.dataset.action === 'accept'

        item.querySelectorAll('button').forEach((b) => { b.disabled = true })

        try {
          const { ok, data } = await post(
            accept ? '/challenges/accept-challenge-completed' : '/challenges/reject-challenge-completed',
            { userId, challengeId }
          )

          if (!ok || data.err) {
            item.querySelectorAll('button').forEach((b) => { b.disabled = false })
            return notify(data.err || 'No se ha podido completar la acción.')
          }

          item.classList.add('queue__item--gone')
          setTimeout(() => { item.remove(); refreshQueueCount() }, 200)

          notify(accept ? 'Reto validado.' : 'Reto rechazado.', 1800, 'success')
        } catch (error) {
          item.querySelectorAll('button').forEach((b) => { b.disabled = false })
          notify('No hay conexión con el servidor.')
        }
      })
    })

    /* ------------------------------------------------------ Crear usuario */

    const passwordInput = $('#user-password')

    $('.hide-password').addEventListener('click', () => {
      const hidden = passwordInput.type === 'password'
      passwordInput.type = hidden ? 'text' : 'password'
      $('.hide-password i').className = hidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye'
    })

    $('#generate-password').addEventListener('click', () => {
      const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789'
      const bytes = crypto.getRandomValues(new Uint32Array(10))
      passwordInput.value = Array.from(bytes, (n) => alphabet[n % alphabet.length]).join('')
      passwordInput.type = 'text'
      $('.hide-password i').className = 'fa-regular fa-eye-slash'
    })

    $('#create-user-form').addEventListener('submit', async (event) => {
      event.preventDefault()

      const email = $('#user-email').value.trim().toLowerCase()
      const name = $('#user-name').value.trim()
      const password = passwordInput.value

      if (!email || !name || !password) return notify('Rellena todos los campos.')

      const { ok, data } = await post('/register', { email, name, password })

      if (!ok || data.err) return notify(data.err || 'No se ha podido crear el usuario.')

      $('#user-email').value = ''
      $('#user-name').value = ''
      passwordInput.value = ''
      $('#user-email').focus()

      notify(`${email} · usuario creado.`, 2400, 'success')
    })

    /* -------------------------------------------------------- Crear reto */

    $('#create-challenge-form').addEventListener('submit', async (event) => {
      event.preventDefault()

      const title = $('#challenge-name').value.trim()
      const description = $('#challenge-description').value.trim()
      const points = $('#challenge-points').value

      if (!title || !description || !points) return notify('Rellena todos los campos.')

      const { ok, data } = await post('/challenges/create-challenge', { title, description, points })

      if (!ok || data.err) return notify(data.err || 'No se ha podido crear el reto.')

      $('#challenge-name').value = ''
      $('#challenge-description').value = ''
      $('#challenge-points').value = ''
      $('#challenge-name').focus()

      notify(`${title} · reto creado.`, 2400, 'success')
    })

    /* ------------------------------------------------------ Añadir puntos */

    const pointsUserPicker = createPicker($('#points-user-picker'), { items: USERS })
    const pointsChallengePicker = createPicker($('#points-challenge-picker'), { items: CHALLENGES })

    $('#add-points-form').addEventListener('submit', async (event) => {
      event.preventDefault()

      const userId = pointsUserPicker.value
      const challengeId = pointsChallengePicker.value

      if (!userId || !challengeId) return notify('Selecciona un usuario y un reto de la lista.')

      const { ok, data } = await post('/add-points', { userId, challengeId })

      if (!ok || data.err) return notify(data.err || 'No se han podido añadir los puntos.')

      pointsUserPicker.clear()
      pointsChallengePicker.clear()

      notify(`${data.points} puntos añadidos.`, 2400, 'success')
    })
  </script>

  <% if (loggedUser.isSuperAdmin) { %>
  <script>
    const extraUserPicker = createPicker($('#extra-user-picker'), { items: USERS })

    $('#add-extra-points-form').addEventListener('submit', async (event) => {
      event.preventDefault()

      const userId = extraUserPicker.value
      const extraPointsText = $('#extra-points-text').value.trim()
      const extraPoints = $('#extra-points').value

      if (!userId || !extraPointsText || extraPoints === '') return notify('Rellena todos los campos.')

      const { ok, data } = await post('/add-extra-points', {
        userId,
        extraPointsText,
        extraPoints: Number(extraPoints)
      })

      if (!ok || data.err) return notify(data.err || 'No se han podido añadir los puntos.')

      extraUserPicker.clear()
      $('#extra-points-text').value = ''
      $('#extra-points').value = ''

      notify(`${data.points} puntos extra añadidos.`, 2400, 'success')
    })
  </script>
  <% } %>
</body>

</html>
