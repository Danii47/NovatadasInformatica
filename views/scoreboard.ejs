<!DOCTYPE html>
<html lang="es">

<head>
  <%- include('partials/head', { title: 'Marcador · Novatadas Informática', extraStyles: ['/styles/navigation.css', '/styles/board.css'] }) %>
</head>

<body>
  <%- include('partials/toast') %>
  <%- include('partials/appbar', { active: 'scoreboard' }) %>

  <main class="page">
    <div class="page-head">
      <div>
        <p class="eyebrow">Curso <%= edition %></p>
        <h1 class="display display--lg">Marcador</h1>
      </div>

      <div class="row">
        <span class="badge"><%= allUsers.length %> participantes</span>
        <% if (loggedUser.isSuperAdmin && allUsers.length > 2) { %>
        <button class="btn btn--sm spin-btn" id="spin-extra-prize">
          <i class="fa-solid fa-gift" aria-hidden="true"></i> Sortear premio
        </button>
        <% } %>
      </div>
    </div>

    <% if (allUsers.length === 0) { %>
    <div class="panel empty-state">Todavía no hay nadie en el marcador.</div>
    <% } else { %>

    <section class="board-list">
      <div class="board-head" aria-hidden="true">
        <span>#</span>
        <span>Participante</span>
        <span class="board-head__meta">Progreso</span>
        <span class="board-head__points">Puntos</span>
      </div>

      <% allUsers.forEach((user, index) => { %>
      <%
        const classes = ['board-row']
        if (index < 3) classes.push(`board-row--${index + 1}`)
        if (user.isExtraWinner) classes.push('board-row--winner')
        if (user.id === loggedUser.id) classes.push('board-row--me')
        const share = totalPoints > 0 ? (user.points / totalPoints * 100).toFixed(1) : '0.0'
      %>
      <article class="<%= classes.join(' ') %>" id="<%= user.id %>" data-user-id="<%= user.id %>" tabindex="0" role="link">
        <span class="board-row__rank num"><%= index + 1 %></span>

        <div class="board-row__name">
          <span><%= user.name %></span>
          <% if (user.id === loggedUser.id) { %><span class="badge badge--brand">Tú</span><% } %>
          <% if (user.isExtraWinner) { %><span class="badge badge--mint">Premio extra</span><% } %>
        </div>

        <div class="board-row__meta">
          <span><%= user.challenges.length + user.extraPoints.length %> retos</span>
          <% if (loggedUser.isAdmin && user.pendingChallenges.length > 0) { %>
          <span class="text-accent"><%= user.pendingChallenges.length %> pendientes</span>
          <% } %>
          <% if (index >= 2) { %>
          <span><%= share %>% sorteo</span>
          <% } %>
        </div>

        <span class="board-row__points num"><%= user.points %></span>
      </article>
      <% }) %>
    </section>
    <% } %>
  </main>

  <script>
    const $ = (selector) => document.querySelector(selector)
    const $$ = (selector) => document.querySelectorAll(selector)

    // Las filas llevan al perfil. `role=link` + tabindex las hace accesibles con
    // teclado, así que también escuchamos Enter.
    $$('[data-user-id]').forEach((element) => {
      const go = () => { window.location.href = `/user/${element.dataset.userId}` }

      element.addEventListener('click', go)
      element.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault()
          go()
        }
      })
    })
  </script>

  <% if (loggedUser.isSuperAdmin && allUsers.length > 2) { %>
  <script>
    const spinButton = $('#spin-extra-prize')

    // Los dos primeros tienen premio asegurado y quedan fuera del sorteo.
    let eligibleIds = <%- jsonForScript(allUsers.slice(2).filter((u) => u.points > 0 && !u.isExtraWinner).map((u) => u.id)) %>

    /**
     * Marca a un ganador en su fila. El distintivo lo pinta el servidor al
     * cargar la página, así que sin esto el resultado del sorteo no se ve
     * hasta recargar.
     */
    function markWinner (row) {
      row.classList.add('board-row--winner')

      const nameCell = row.querySelector('.board-row__name')

      if (nameCell && !nameCell.querySelector('.badge--mint')) {
        const badge = document.createElement('span')
        badge.className = 'badge badge--mint'
        badge.textContent = 'Premio extra'
        nameCell.appendChild(badge)
      }

      // Fuera de futuros sorteos sin necesidad de recargar.
      eligibleIds = eligibleIds.filter((id) => id !== row.id)
    }

    const audio = new Audio('/sounds/tap.mp3')
    audio.volume = 0.3

    spinButton.addEventListener('click', async () => {
      const rows = eligibleIds
        .map((id) => document.getElementById(id))
        .filter(Boolean)

      if (rows.length === 0) return notify('No queda nadie elegible para el sorteo.')

      spinButton.disabled = true
      spinButton.classList.add('is-spinning')

      let current = Math.floor(Math.random() * rows.length)

      const spinning = setInterval(() => {
        audio.currentTime = 0
        audio.play().catch(() => {})
        rows[current].classList.remove('board-row--spinning')
        current = Math.floor(Math.random() * rows.length)
        rows[current].classList.add('board-row--spinning')
      }, 75)

      const stop = () => {
        clearInterval(spinning)
        rows.forEach((row) => row.classList.remove('board-row--spinning'))
        spinButton.classList.remove('is-spinning')
        spinButton.disabled = false
      }

      setTimeout(async () => {
        try {
          const res = await fetch('/spin-extra-prize')
          const data = await res.json()

          stop()

          if (!res.ok || data.err) return notify(data.err || 'No se ha podido sortear.')
          if (!data.winner) return notify('El sorteo no ha encontrado ganador.')

          const winnerRow = document.getElementById(data.winner.id)
          if (winnerRow) {
            markWinner(winnerRow)
            winnerRow.scrollIntoView({ behavior: 'smooth', block: 'center' })
          }

          // Si ya no queda nadie elegible, el botón deja de tener sentido.
          if (eligibleIds.length === 0) spinButton.disabled = true

          notify(`El premio extra ha sido para ${data.winner.name}.`, 3500, 'success')
        } catch (error) {
          stop()
          notify('No hay conexión con el servidor.')
        }
      }, 4000)
    })
  </script>
  <% } %>
</body>

</html>
